<?php declare(strict_types=1); ?>
<?php if (!$this->isSupported()): ?>
	<p><?= htmlspecialchars($this->compatibilityMessage(), ENT_QUOTES, 'UTF-8') ?></p>
<?php else: ?>
	<?php $settings = $this->settings(); ?>
	<form action="<?= _url('extension', 'configure', 'e', urlencode($this->getName())) ?>" method="post" data-auto-leave-validation="1">
		<input type="hidden" name="_csrf" value="<?= FreshRSS_Auth::csrfToken() ?>" />
		<fieldset>
			<legend>Feeds to repair</legend>
			<?php if ($this->feeds === []): ?>
				<p>Add a subscription to make it available here.</p>
			<?php else: ?>
				<p>Choose the feeds whose new article titles should be repaired.</p>
				<?php foreach ($this->feeds as $id => $feed): ?>
					<div>
						<label class="checkbox">
							<input type="checkbox" name="entity_exorcist_feeds[]" value="<?= $id ?>"<?= in_array($id, $settings['feed_ids'], true) ? ' checked' : '' ?> />
							<?= htmlspecialchars(htmlspecialchars_decode($feed->name(), ENT_QUOTES), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>
							(#<?= $id ?>)
						</label>
					</div>
				<?php endforeach; ?>
			<?php endif; ?>
		</fieldset>
		<div class="form-group">
			<div class="group-controls">
				<label class="checkbox">
					<input type="checkbox" name="entity_exorcist_nbsp" value="1"<?= $settings['normalize_nbsp'] ? ' checked' : '' ?> />
					Replace non-breaking spaces with regular spaces in selected feeds
				</label>
			</div>
		</div>
		<div class="form-group form-actions">
			<div class="group-controls">
				<button type="submit" class="btn btn-important"><?= _t('gen.action.submit') ?></button>
			</div>
		</div>
	</form>
<?php endif; ?>
